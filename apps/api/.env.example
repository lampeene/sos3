# Server
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# JWT – CHANGE THIS IN PRODUCTION (min 32 characters)
JWT_SECRET=super-secret-change-me-in-production-min-32-chars

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sos_points?schema=public

# PayPlug – https://portal.payplug.com/
PAYPLUG_SECRET_KEY=your_secret_key_here
PAYPLUG_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudinary – https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_FOLDER=sos-points

# Mail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@sos-point.com
MAIL_ADMIN=admin@sos-point.com

# ========== Logging ==========
# Level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=debug

# Format: json | pretty | compact
#   json    → one JSON object per line (prod / aggregators)
#   pretty  → colored human-readable (local dev)
#   compact → key=value single line
LOG_FORMAT=pretty

# Timestamp: iso | epoch | simple
LOG_TIMESTAMP=iso

# Colors in pretty mode (ignored for json)
LOG_COLOR=true

# Include stack traces on errors
LOG_STACK=true

# Include extra metadata fields
LOG_META=true

# Comma-separated fields to strip from output
# LOG_OMIT_FIELDS=splat

# Truncate long messages (0 = no limit)
# LOG_MAX_MESSAGE_LENGTH=500

LOG_SERVICE=sos-points-api
NODE_ENV=development
APP_VERSION=2.0.0

# ========== Log transports ==========
LOG_CONSOLE=true
LOG_FILE=true
LOG_FILE_DIR=logs
LOG_FILE_APP=app.log
LOG_FILE_ERROR=error.log
LOG_FILE_MAX_SIZE=10485760
LOG_FILE_MAX_FILES=10
LOG_FILE_ERROR_MAX_SIZE=5242880
LOG_FILE_ERROR_MAX_FILES=5

# Optional: ship logs to a remote HTTP endpoint (JSON POST)
# LOG_HTTP_URL=https://logs.example.com/ingest
# LOG_HTTP_LEVEL=warn

# Disable all logging (useful in tests)
# LOG_SILENT=false

# ========== Log rotation ==========
# Daily rotation (recommended) – requires winston-daily-rotate-file
LOG_ROTATE_DAILY=true
LOG_ROTATE_DATE_PATTERN=YYYY-MM-DD
LOG_ROTATE_MAX_SIZE=20m
LOG_ROTATE_MAX_FILES=14d
LOG_ROTATE_ERROR_MAX_SIZE=10m
LOG_ROTATE_ERROR_MAX_FILES=30d
LOG_ROTATE_ZIP=true

# Filenames (use %DATE% placeholder when daily is enabled)
LOG_FILE_APP=app-%DATE%.log
LOG_FILE_ERROR=error-%DATE%.log

# ========== ELK Stack ==========
# LOG_ELK_ENABLED=false
# LOG_ELK_MODE=filebeat
#   filebeat       → ship via Filebeat reading log files (recommended)
#   http           → Winston posts JSON to Logstash HTTP input
#   elasticsearch  → direct to Elasticsearch (requires winston-elasticsearch)

# HTTP → Logstash
# LOG_ELK_HTTP_URL=http://localhost:8080
# LOG_ELK_HTTP_LEVEL=info

# Direct Elasticsearch
# LOG_ELK_ES_NODE=http://localhost:9200
# LOG_ELK_ES_INDEX=sos-points-logs
# LOG_ELK_ES_USERNAME=
# LOG_ELK_ES_PASSWORD=
# LOG_ELK_ES_LEVEL=info
