{
  "name": "sos-points",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@sos-points/database",
    "db:migrate": "turbo run db:migrate --filter=@sos-points/database",
    "db:studio": "turbo run db:studio --filter=@sos-points/database"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
    "packageManager": "npm@10.8.2"
}
